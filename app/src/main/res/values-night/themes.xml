<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NoticeBoard" parent="android:Theme.Material.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/noticeboard_green</item>
        <item name="android:colorPrimaryDark">@color/noticeboard_green_dark</item>
        <item name="android:colorAccent">@color/noticeboard_orange</item>

        <!-- Status bar configuration for dark theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/noticeboard_gray_dark</item>
        <item name="android:textColorPrimary">@color/noticeboard_gray_light</item>

        <!--splash screen background-->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/noticeboard_green_dark</item>

    </style>
</resources>
