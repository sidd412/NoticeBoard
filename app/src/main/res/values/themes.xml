<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NoticeBoard" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/noticeboard_green</item>
        <item name="android:colorPrimaryDark">@color/noticeboard_green_dark</item>
        <item name="android:colorAccent">@color/noticeboard_orange</item>

        <!-- Status bar configuration -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/noticeboard_green_very_light</item>
        <item name="android:textColorPrimary">@color/noticeboard_gray_dark</item>

        <!--splash screen background-->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/noticeboard_green_dark</item>
        <!-- <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>-->
        <!-- <item name="windowSplashScreenBackground">@color/background_color</item>-->
        <!-- <item name="windowSplashScreenAnimatedIcon" >@drawable/ic_launcher_foreground</item>-->

    </style>
</resources>