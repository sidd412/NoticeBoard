rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notice boards can be read by anyone, written by authenticated users
    match /noticeBoards/{boardId} {
      allow read: if true; // Anyone can read notice boards
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Notices can be read by anyone, written by authenticated users
    match /notices/{noticeId} {
      allow read: if true; // Anyone can read notices
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Pages can be read by anyone, written by authenticated users
    match /pages/{pageId} {
      allow read: if true; // Anyone can read pages
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Board deletion requests - users can create requests for their own boards
    match /boardDeletionRequests/{requestId} {
      allow read, write: if request.auth != null; // Only authenticated users can read/write
    }
    
    // Data export requests - users can create requests for their own data
    match /dataExportRequests/{requestId} {
      allow read, write: if request.auth != null; // Only authenticated users can read/write
    }
    
    // Purchases - users can read their own purchases, write their own purchases
    match /purchases/{purchaseId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId);
    }
    
    // User queries - users can create queries and read their own queries
    match /userQueries/{queryId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.raiserId || request.auth.uid == request.resource.data.raiserId);
    }
    
    // TEMPORARY: Allow all operations for testing (REMOVE IN PRODUCTION)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

